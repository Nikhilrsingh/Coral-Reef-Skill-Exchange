cd ~/Desktop/Coral-Reef-Major-Project && cat > .gitignore <<'EOF'
# macOS
.DS_Store

# VS Code
.vscode/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Django
*.log
db.sqlite3
db.sqlite3-journal

# Python virtual environment
venv/
.venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build / distribution
dist/
build/

# Coverage / test cache
.coverage
htmlcov/
.pytest_cache/

# IDE / OS files
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
EOF