<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Find Matches | Coral Reef</title>

    <link
        rel="stylesheet"
        href="../assets/css/layout.css"
    >

    <link
        rel="stylesheet"
        href="../assets/css/style.css"
    >

    <link
        rel="stylesheet"
        href="../assets/css/responsive.css"
    >

    <style>

        .matches-page {
            min-height: 100vh;
            padding: 120px 20px 60px;
        }

        .matches-header {
            max-width: 1200px;
            margin: 0 auto 35px;
        }

        .matches-header h1 {
            margin-bottom: 8px;
        }

        .matches-header p {
            opacity: 0.7;
        }

        .matches-toolbar {
            max-width: 1200px;
            margin: 0 auto 30px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .matches-search {
            flex: 1;
            min-width: 240px;
            padding: 14px 18px;
            border-radius: 12px;
            border: 1px solid rgba(128,128,128,.3);
            font-size: 15px;
        }

        .matches-grid {
            max-width: 1200px;
            margin: auto;
            display: grid;
            grid-template-columns:
                repeat(auto-fill, minmax(280px, 1fr));
            gap: 22px;
        }

        .match-card {
            border: 1px solid rgba(128,128,128,.2);
            border-radius: 18px;
            padding: 24px;
            background: var(--card-bg, #fff);
            transition:
                transform .2s ease,
                box-shadow .2s ease;
            cursor: pointer;
        }

        .match-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,.12);
        }

        .match-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .match-avatar {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0,120,140,.12);
            font-weight: 700;
            font-size: 20px;
            overflow: hidden;
        }

        .match-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .match-score {
            font-weight: 700;
            font-size: 14px;
        }

        .match-name {
            margin-top: 18px;
            margin-bottom: 4px;
        }

        .match-role {
            opacity: .65;
            font-size: 14px;
        }

        .match-bio {
            margin: 16px 0;
            opacity: .8;
            line-height: 1.5;
        }

        .match-skills {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .skill-tag {
            padding: 6px 10px;
            border-radius: 20px;
            background: rgba(0,120,140,.1);
            font-size: 12px;
        }

        .match-actions {
            margin-top: 20px;
            display: flex;
            gap: 10px;
        }

        .match-button {
            flex: 1;
            border: 0;
            border-radius: 10px;
            padding: 11px;
            cursor: pointer;
            font-weight: 600;
        }

        .match-button.secondary {
            background: rgba(128,128,128,.12);
        }

        .match-button.primary {
            background: #087f8c;
            color: white;
        }

        .matches-state {
            max-width: 700px;
            margin: 70px auto;
            text-align: center;
            opacity: .7;
        }

        .hidden {
            display: none !important;
        }

    </style>

</head>


<body>

<header class="navbar">

    <div class="container navbar-container">

        <a href="../index.html" class="logo">

            <img
                src="../assets/images/logos/logo.png"
                alt="Coral Reef Logo"
                class="logo-image"
            >

            <div class="logo-content">

                <h1>Coral Reef 🪸</h1>

                <span>Where Knowledge Unites</span>

            </div>

        </a>


        <nav class="nav-menu">

            <ul class="nav-links">

                <li>
                    <a href="../index.html">
                        Home
                    </a>
                </li>

                <li>
                    <a
                        href="matches.html"
                        class="active"
                    >
                        Find Matches
                    </a>
                </li>

                <li>
                    <a href="profile.html">
                        My Profile
                    </a>
                </li>

                <li>
                    <a href="messages.html">
                        Messages
                    </a>
                </li>

                <li>
                    <a href="contact.html">
                        Contact
                    </a>
                </li>

            </ul>

        </nav>

    </div>

</header>


<main class="matches-page">

    <section class="matches-header">

        <h1>Find Your Learning Partners</h1>

        <p>
            Discover people whose skills match what
            you want to learn and teach.
        </p>

    </section>


    <div class="matches-toolbar">

        <input
            type="search"
            id="matchSearch"
            class="matches-search"
            placeholder="Search by name, role or skill..."
        >

    </div>


    <section
        id="matchesGrid"
        class="matches-grid"
    ></section>


    <div
        id="loadingState"
        class="matches-state"
    >
        <h2>Finding your matches...</h2>
        <p>Please wait.</p>
    </div>


    <div
        id="emptyState"
        class="matches-state hidden"
    >
        <h2>No matches yet</h2>
        <p>
            Add teaching and learning skills to your
            profile to discover learning partners.
        </p>
    </div>


    <div
        id="errorState"
        class="matches-state hidden"
    >
        <h2>Unable to load matches</h2>
        <p id="errorMessage">
            Please try again.
        </p>
    </div>

</main>


<script type="module">

    import authService
        from "../js/services/authService.js";


    const API_BASE_URL =
        "http://127.0.0.1:8000/api";


    const grid =
        document.getElementById("matchesGrid");

    const loading =
        document.getElementById("loadingState");

    const empty =
        document.getElementById("emptyState");

    const error =
        document.getElementById("errorState");

    const errorMessage =
        document.getElementById("errorMessage");

    const search =
        document.getElementById("matchSearch");


    let allMatches = [];


    function getInitials(name) {

        if (!name) {
            return "?";
        }

        return name
            .trim()
            .split(/\s+/)
            .slice(0, 2)
            .map(word => word[0])
            .join("")
            .toUpperCase();

    }


    function createSkillTags(skills) {

        if (!Array.isArray(skills)) {
            return "";
        }

        return skills
            .map(skill =>
                `<span class="skill-tag">
                    ${escapeHTML(skill)}
                </span>`
            )
            .join("");

    }


    function escapeHTML(value) {

        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");

    }


    function renderMatches(matches) {

        grid.innerHTML = "";

        if (!matches.length) {

            empty.classList.remove("hidden");

            return;

        }

        empty.classList.add("hidden");


        matches.forEach(match => {

            const card =
                document.createElement("article");

            card.className = "match-card";


            const teaches =
                Array.isArray(match.teaches_skills)
                    ? match.teaches_skills
                    : [];


            const learns =
                Array.isArray(match.learns_skills)
                    ? match.learns_skills
                    : [];


            const skills =
                [...new Set([
                    ...teaches,
                    ...learns
                ])];


            const image =
                match.profile_image
                    ? `
                        <img
                            src="${escapeHTML(match.profile_image)}"
                            alt=""
                        >
                    `
                    : getInitials(match.name);


            card.innerHTML = `

                <div class="match-top">

                    <div class="match-avatar">
                        ${image}
                    </div>

                    <div class="match-score">
                        ${match.match_score ?? 0}% match
                    </div>

                </div>


                <h2 class="match-name">
                    ${escapeHTML(match.name)}
                </h2>


                <div class="match-role">
                    ${escapeHTML(
                        match.role || "Member"
                    )}
                </div>


                <p class="match-bio">
                    ${escapeHTML(
                        match.bio ||
                        "Coral Reef member"
                    )}
                </p>


                <div class="match-skills">
                    ${createSkillTags(skills)}
                </div>


                <div class="match-actions">

                    <button
                        class="match-button secondary view-profile"
                    >
                        View Profile
                    </button>

                    <button
                        class="match-button primary connect-button"
                    >
                        Connect
                    </button>

                </div>

            `;


            card
                .querySelector(".view-profile")
                .addEventListener(
                    "click",
                    event => {

                        event.stopPropagation();

                        showProfile(match);

                    }
                );


            card
                .querySelector(".connect-button")
                .addEventListener(
                    "click",
                    event => {

                        event.stopPropagation();

                        connectUser(match);

                    }
                );


            card.addEventListener(
                "click",
                () => showProfile(match)
            );


            grid.appendChild(card);

        });

    }


    function showProfile(match) {

        alert(
            `${match.name}\n\n` +
            `Match Score: ${match.match_score}%\n\n` +
            `${match.bio || "No bio available."}`
        );

    }


    function connectUser(match) {

        alert(
            `Connection request sent to ${match.name}.`
        );

    }


    async function loadMatches() {

        const token =
            authService.getToken();


        if (!token) {

            loading.classList.add("hidden");

            error.classList.remove("hidden");

            errorMessage.textContent =
                "Please login first.";

            return;

        }


        const user =
            await authService
                .getCurrentUserFromAPI();


        if (!user || !user.id) {

            throw new Error(
                "Your profile could not be found."
            );

        }


        const response =
            await fetch(
                `${API_BASE_URL}/users/${user.id}/matches/`,
                {
                    headers: {
                        "Authorization":
                            `Token ${token}`
                    }
                }
            );


        const data =
            await response.json();


        if (!response.ok) {

            throw new Error(
                data.error ||
                "Unable to load matches."
            );

        }


        allMatches =
            Array.isArray(data.matches)
                ? data.matches
                : [];


        loading.classList.add("hidden");

        renderMatches(allMatches);

    }


    search.addEventListener(
        "input",
        () => {

            const query =
                search.value
                    .trim()
                    .toLowerCase();


            const filtered =
                allMatches.filter(match => {

                    const skills = [
                        ...(match.teaches_skills || []),
                        ...(match.learns_skills || [])
                    ]
                    .join(" ");


                    return (
                        (match.name || "")
                            .toLowerCase()
                            .includes(query)
                        ||
                        (match.role || "")
                            .toLowerCase()
                            .includes(query)
                        ||
                        skills
                            .toLowerCase()
                            .includes(query)
                    );

                });


            renderMatches(filtered);

        }
    );


    loadMatches()
        .catch(err => {

            console.error(err);

            loading.classList.add("hidden");

            error.classList.remove("hidden");

            errorMessage.textContent =
                err.message ||
                "Something went wrong.";

        });

</script>

</body>

</html>