<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Profile | Coral Reef</title>

    <link rel="stylesheet" href="../assets/css/reset.css">
    <link rel="stylesheet" href="../assets/css/variables.css">
    <link rel="stylesheet" href="../assets/css/profile.css">

</head>

<body>

    <header class="profile-navbar">

        <a
            href="../index.html"
            class="profile-brand"
        >

            <img
                src="../assets/images/logos/logo.png"
                alt="Coral Reef Logo"
            >

            <span>Coral Reef 🪸</span>

        </a>


        <nav>

            <a href="../index.html">
                Home
            </a>

            <button
                type="button"
                data-action="logout"
                class="profile-logout"
            >
                Logout
            </button>

        </nav>

    </header>


    <main class="profile-page">

        <section class="profile-header">

            <p class="profile-label">
                USER MANAGEMENT
            </p>

            <h1>
                My Profile
            </h1>

            <p>
                Manage your information, skills and
                learning interests.
            </p>

        </section>


        <section class="profile-card">

            <form
                id="profileForm"
                class="profile-form"
            >

                <!-- BASIC INFORMATION -->

                <div class="profile-section">

                    <h2>Basic Information</h2>

                    <p>
                        Your basic account information.
                    </p>


                    <div class="profile-grid">

                        <div class="profile-field">

                            <label for="name">
                                Full Name
                            </label>

                            <input
                                type="text"
                                id="name"
                                required
                            >

                        </div>


                        <div class="profile-field">

                            <label for="email">
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                disabled
                            >

                            <small>
                                Email cannot be changed from the profile.
                            </small>

                        </div>


                        <div class="profile-field">

                            <label for="role">
                                Role
                            </label>

                            <select id="role">

                                <option value="student">
                                    Student
                                </option>

                                <option value="teacher">
                                    Teacher
                                </option>

                                <option value="professional">
                                    Professional
                                </option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- BIO -->

                <div class="profile-section">

                    <h2>About You</h2>

                    <p>
                        Tell the community a little about yourself.
                    </p>

                    <div class="profile-field">

                        <label for="bio">
                            Bio
                        </label>

                        <textarea
                            id="bio"
                            rows="5"
                            maxlength="500"
                            placeholder="Write a short introduction..."
                        ></textarea>

                        <small>
                            Maximum 500 characters.
                        </small>

                    </div>

                </div>


                <!-- TEACHING SKILLS -->

                <div class="profile-section">

                    <h2>Skills I Can Teach</h2>

                    <p>
                        Add skills that you can share with others.
                    </p>

                    <div class="skill-input-row">

                        <input
                            type="text"
                            id="teachSkillInput"
                            placeholder="Example: JavaScript"
                        >

                        <button
                            type="button"
                            id="addTeachSkill"
                            class="skill-add-button"
                        >
                            Add
                        </button>

                    </div>

                    <div
                        id="teachSkills"
                        class="skill-list"
                    ></div>

                </div>


                <!-- LEARNING SKILLS -->

                <div class="profile-section">

                    <h2>Skills I Want To Learn</h2>

                    <p>
                        Add skills that you want to learn.
                    </p>

                    <div class="skill-input-row">

                        <input
                            type="text"
                            id="learnSkillInput"
                            placeholder="Example: Python"
                        >

                        <button
                            type="button"
                            id="addLearnSkill"
                            class="skill-add-button"
                        >
                            Add
                        </button>

                    </div>

                    <div
                        id="learnSkills"
                        class="skill-list"
                    ></div>

                </div>


                <!-- CONNECTED PROFILES -->

<div class="profile-section connected-profiles-section">

    <h2>Connected Profiles</h2>

    <p>
        Connect your professional, coding and creative
        profiles in one place.
    </p>


    <!-- CONNECTED PROFILE LIST -->

    <div
        id="connectedProfiles"
        class="connected-profile-list"
    ></div>


    <!-- ADD PROFILE -->

    <div class="connected-profile-form">

        <div class="connected-profile-form-header">

            <div>
                <h3>Add a Profile</h3>

                <p>
                    Add a profile you want to showcase
                    on your Coral Reef profile.
                </p>
            </div>

        </div>


        <div class="connected-profile-fields">

            <!-- PLATFORM -->

            <div class="profile-field">

                <label for="connectedPlatform">
                    Platform
                </label>

                <select id="connectedPlatform">

                    <option value="github">
                        GitHub
                    </option>

                    <option value="linkedin">
                        LinkedIn
                    </option>

                    <option value="leetcode">
                        LeetCode
                    </option>

                    <option value="codechef">
                        CodeChef
                    </option>

                    <option value="codeforces">
                        Codeforces
                    </option>

                    <option value="hackerrank">
                        HackerRank
                    </option>

                    <option value="behance">
                        Behance
                    </option>

                    <option value="website">
                        Personal Website
                    </option>

                    <option value="other">
                        Other
                    </option>

                </select>

            </div>


            <!-- USERNAME -->

            <div class="profile-field">

                <label for="connectedUsername">
                    Username
                </label>

                <input
                    type="text"
                    id="connectedUsername"
                    placeholder="Example: Nikhilrsingh"
                >

            </div>


            <!-- PROFILE URL -->

            <div class="profile-field">

                <label for="connectedProfileUrl">
                    Profile URL
                </label>

                <input
                    type="url"
                    id="connectedProfileUrl"
                    placeholder="https://github.com/username"
                >

            </div>

        </div>


        <div class="connected-profile-form-actions">

            <button
                type="button"
                id="addConnectedProfile"
                class="skill-add-button"
            >
                Connect Profile
            </button>

        </div>

    </div>

</div>


<!-- MESSAGE -->



                <!-- MESSAGE -->

                <div
                    id="profileMessage"
                    class="profile-message"
                ></div>


                <!-- SAVE -->

                <div class="profile-actions">

                    <button
                        type="submit"
                        class="save-profile-button"
                    >
                        Save Changes
                    </button>

                </div>

            </form>

        </section>

    </main>


    <script
        type="module"
        src="../js/modules/sessionGuard.js"
    ></script>

    <script
        type="module"
        src="../js/modules/profile.js"
    ></script>

    <script
        type="module"
        src="../js/modules/logout.js"
    ></script>

</body>

</html>