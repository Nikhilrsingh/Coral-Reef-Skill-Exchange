/* =========================================================
   CORAL REEF — PROFILE PAGE
   Clean professional dashboard UI
========================================================= */


/* =========================================================
   NAVBAR
========================================================= */

.profile-navbar {

    min-height: 72px;
    padding: 0 6%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: var(--primary);
    color: #fff;

    box-shadow: 0 4px 18px rgba(15, 42, 86, .10);
}


.profile-brand {

    display: flex;
    align-items: center;
    gap: 12px;

    color: #fff;

    font-family: var(--heading-font);
    font-size: 1.25rem;
    font-weight: 700;

    text-decoration: none;
}


.profile-brand img {

    width: 42px;
    height: 42px;

    padding: 4px;

    object-fit: contain;

    background: #fff;
    border-radius: 50%;
}


.profile-navbar nav {

    display: flex;
    align-items: center;
    gap: 24px;
}


.profile-navbar nav a {

    color: #fff;

    font-size: .92rem;
    font-weight: 600;

    text-decoration: none;

    opacity: .92;

    transition: .25s ease;
}


.profile-navbar nav a:hover {

    opacity: 1;
}


.profile-logout {

    padding: 9px 17px;

    border: 1px solid rgba(255,255,255,.45);
    border-radius: 9px;

    background: transparent;
    color: #fff;

    font-family: inherit;
    font-weight: 600;

    cursor: pointer;

    transition: .25s ease;
}


.profile-logout:hover {

    background: rgba(255,255,255,.12);
    border-color: rgba(255,255,255,.7);
}


/* =========================================================
   PAGE BACKGROUND
========================================================= */

body {

    background:
        linear-gradient(
            180deg,
            #f7fbff 0%,
            #f4f8fc 100%
        );
}


.profile-page {

    width: min(1080px, 92%);

    margin: 0 auto;

    padding: 52px 0 80px;
}


/* =========================================================
   PAGE HEADER
========================================================= */

.profile-header {

    margin-bottom: 30px;
}


.profile-label {

    display: inline-flex;

    margin-bottom: 10px;

    color: var(--primary);

    font-size: .72rem;
    font-weight: 800;

    letter-spacing: 1.8px;
}


.profile-header h1 {

    margin: 0 0 8px;

    color: var(--text-dark);

    font-family: var(--heading-font);

    font-size: clamp(2rem, 4vw, 2.65rem);

    line-height: 1.15;
}


.profile-header > p:last-child {

    max-width: 620px;

    margin: 0;

    color: var(--text-light);

    font-size: .95rem;

    line-height: 1.7;
}


/* =========================================================
   MAIN PROFILE CARD
========================================================= */

.profile-card {

    overflow: hidden;

    background: #fff;

    border: 1px solid rgba(226,232,240,.9);

    border-radius: 20px;

    box-shadow:
        0 12px 40px rgba(15,42,86,.07);
}


/* =========================================================
   SECTIONS
========================================================= */

.profile-section {

    padding: 32px 38px;

    border-bottom: 1px solid #edf1f5;
}


.profile-section:last-child {

    border-bottom: none;
}


.profile-section h2 {

    margin: 0 0 6px;

    color: var(--text-dark);

    font-family: var(--heading-font);

    font-size: 1.18rem;
    font-weight: 700;
}


.profile-section > p {

    margin: 0 0 22px;

    color: var(--text-light);

    font-size: .88rem;

    line-height: 1.6;
}


/* =========================================================
   BASIC INFORMATION GRID
========================================================= */

.profile-grid {

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 22px;
}


/* =========================================================
   FORM FIELDS
========================================================= */

.profile-field {

    display: flex;

    flex-direction: column;

    gap: 8px;
}


.profile-field label {

    color: var(--text-dark);

    font-size: .84rem;

    font-weight: 700;
}


.profile-field input,
.profile-field select,
.profile-field textarea {

    width: 100%;
    box-sizing: border-box;

    padding: 12px 14px;

    border: 1px solid #dce3eb;
    border-radius: 10px;

    background: #fff;

    color: var(--text-dark);

    font-family: var(--body-font);
    font-size: .9rem;

    outline: none;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;
}


.profile-field input::placeholder,
.profile-field textarea::placeholder {

    color: #a5afbb;
}


.profile-field input:hover,
.profile-field select:hover,
.profile-field textarea:hover {

    border-color: #cbd5e1;
}


.profile-field input:focus,
.profile-field select:focus,
.profile-field textarea:focus {

    border-color: var(--primary);

    box-shadow:
        0 0 0 3px rgba(18,97,214,.09);
}


.profile-field textarea {

    min-height: 125px;

    resize: vertical;

    line-height: 1.6;
}


.profile-field input:disabled {

    background: #f6f8fa;

    color: #7c8794;

    cursor: not-allowed;
}


.profile-field small {

    color: var(--text-light);

    font-size: .74rem;

    line-height: 1.5;
}


/* =========================================================
   SKILLS
========================================================= */

.skill-input-row {

    display: flex;

    align-items: stretch;

    gap: 10px;
}


.skill-input-row input {

    flex: 1;

    min-width: 0;

    padding: 12px 14px;

    border: 1px solid #dce3eb;
    border-radius: 10px;

    background: #fff;

    color: var(--text-dark);

    font-family: var(--body-font);

    outline: none;

    transition: .2s ease;
}


.skill-input-row input:focus {

    border-color: var(--primary);

    box-shadow:
        0 0 0 3px rgba(18,97,214,.09);
}


.skill-add-button {

    min-height: 44px;

    padding: 0 20px;

    border: none;

    border-radius: 10px;

    background: var(--primary);

    color: #fff;

    font-family: var(--heading-font);

    font-size: .84rem;

    font-weight: 700;

    cursor: pointer;

    white-space: nowrap;

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}


.skill-add-button:hover {

    background: var(--primary-dark);

    transform: translateY(-1px);

    box-shadow:
        0 6px 15px rgba(18,97,214,.18);
}


.skill-add-button:disabled {

    opacity: .65;

    cursor: not-allowed;

    transform: none;

    box-shadow: none;
}


.skill-list {

    display: flex;

    flex-wrap: wrap;

    gap: 9px;

    margin-top: 16px;
}


.skill-tag {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 8px 11px;

    border: 1px solid rgba(18,97,214,.12);

    border-radius: 999px;

    background: rgba(18,97,214,.07);

    color: var(--primary);

    font-size: .8rem;

    font-weight: 700;
}


.skill-remove {

    width: 19px;
    height: 19px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    border: none;
    border-radius: 50%;

    background: transparent;

    color: var(--primary);

    font-size: .95rem;

    line-height: 1;

    cursor: pointer;
}


.skill-remove:hover {

    background: rgba(18,97,214,.13);
}


/* =========================================================
   CONNECTED PROFILES
========================================================= */

.connected-profiles-section {

    padding-bottom: 36px;
}


/* PROFILE CARDS CONTAINER */

.connected-profile-list {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 14px;

    margin-bottom: 28px;
}


/* INDIVIDUAL PROFILE CARD */

.connected-profile-card {

    position: relative;

    display: flex;

    align-items: center;

    gap: 14px;

    min-width: 0;

    padding: 17px;

    border: 1px solid #e3e9f0;

    border-radius: 14px;

    background: #fff;

    box-shadow:
        0 5px 18px rgba(15,42,86,.045);

    transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease;
}


.connected-profile-card:hover {

    transform: translateY(-2px);

    border-color: rgba(18,97,214,.22);

    box-shadow:
        0 10px 25px rgba(15,42,86,.08);
}


/* PLATFORM ICON AREA */

.connected-profile-card::before {

    content: "";

    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            rgba(18,97,214,.12),
            rgba(18,97,214,.04)
        );
}


/* TEXT */

.connected-profile-card strong {

    display: block;

    margin-bottom: 3px;

    color: var(--text-dark);

    font-size: .84rem;
}


.connected-profile-card span {

    display: block;

    max-width: 190px;

    overflow: hidden;

    color: var(--text-light);

    font-size: .8rem;

    text-overflow: ellipsis;

    white-space: nowrap;
}


.connected-profile-card a {

    margin-left: auto;

    flex-shrink: 0;

    color: var(--primary);

    font-size: .76rem;

    font-weight: 700;

    text-decoration: none;
}


.connected-profile-card a:hover {

    text-decoration: underline;
}


/* EMPTY STATE */

.connected-profile-empty {

    grid-column: 1 / -1;

    margin: 0 0 6px;

    padding: 25px;

    border: 1px dashed #d6dee8;

    border-radius: 13px;

    background: #fafcff;

    color: var(--text-light);

    text-align: center;

    font-size: .84rem;
}


/* =========================================================
   ADD PROFILE PANEL
========================================================= */

.connected-profile-form {

    padding: 24px;

    border: 1px solid #e3e9f0;

    border-radius: 15px;

    background:
        linear-gradient(
            180deg,
            #fbfdff 0%,
            #f7faff 100%
        );
}


.connected-profile-form-header {

    margin-bottom: 20px;
}


.connected-profile-form-header h3 {

    margin: 0 0 5px;

    color: var(--text-dark);

    font-family: var(--heading-font);

    font-size: 1rem;
}


.connected-profile-form-header p {

    margin: 0;

    color: var(--text-light);

    font-size: .8rem;

    line-height: 1.5;
}


.connected-profile-fields {

    display: grid;

    grid-template-columns:
        .85fr 1fr 1.5fr;

    gap: 16px;

    align-items: end;
}


.connected-profile-form-actions {

    display: flex;

    justify-content: flex-end;

    margin-top: 18px;
}


/* =========================================================
   MESSAGE
========================================================= */

.profile-message {

    display: none;

    margin: 24px 38px 0;

    padding: 12px 15px;

    border-radius: 10px;

    font-size: .84rem;

    line-height: 1.5;
}


.profile-message.show {

    display: block;
}


.profile-message.success {

    background: #effaf3;

    border: 1px solid #c8e8d2;

    color: var(--success);
}


.profile-message.error {

    background: #fff3f3;

    border: 1px solid #ffd2d2;

    color: var(--danger);
}


/* =========================================================
   SAVE ACTIONS
========================================================= */

.profile-actions {

    display: flex;

    justify-content: flex-end;

    padding: 24px 38px;

    background: #fbfcfe;

    border-top: 1px solid #edf1f5;
}


.save-profile-button {

    padding: 12px 23px;

    border: none;

    border-radius: 10px;

    background: var(--primary);

    color: #fff;

    font-family: var(--heading-font);

    font-size: .86rem;

    font-weight: 700;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}


.save-profile-button:hover {

    background: var(--primary-dark);

    transform: translateY(-1px);

    box-shadow:
        0 7px 17px rgba(18,97,214,.18);
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 850px) {

    .connected-profile-fields {

        grid-template-columns: 1fr 1fr;
    }


    .connected-profile-fields
    .profile-field:last-child {

        grid-column: 1 / -1;
    }

}


@media (max-width: 700px) {

    .profile-navbar {

        padding: 0 5%;
    }


    .profile-navbar nav {

        gap: 10px;
    }


    .profile-navbar nav a {

        display: none;
    }


    .profile-page {

        width: 94%;

        padding: 35px 0 55px;
    }


    .profile-header {

        margin-bottom: 22px;
    }


    .profile-header h1 {

        font-size: 2rem;
    }


    .profile-section {

        padding: 25px 20px;
    }


    .profile-grid {

        grid-template-columns: 1fr;

        gap: 17px;
    }


    .skill-input-row {

        flex-direction: column;
    }


    .skill-add-button {

        width: 100%;

        padding: 12px 18px;
    }


    .connected-profile-list {

        grid-template-columns: 1fr;
    }


    .connected-profile-fields {

        grid-template-columns: 1fr;
    }


    .connected-profile-fields
    .profile-field:last-child {

        grid-column: auto;
    }


    .connected-profile-form {

        padding: 19px;
    }


    .connected-profile-card {

        padding: 14px;
    }


    .connected-profile-card a {

        font-size: .72rem;
    }


    .profile-message {

        margin-left: 20px;
        margin-right: 20px;
    }


    .profile-actions {

        padding: 20px;

        justify-content: stretch;
    }


    .save-profile-button {

        width: 100%;
    }

}


@media (max-width: 420px) {

    .profile-brand span {

        font-size: 1rem;
    }


    .profile-brand img {

        width: 37px;
        height: 37px;
    }


    .profile-navbar {

        min-height: 65px;
    }


    .profile-header h1 {

        font-size: 1.75rem;
    }


    .connected-profile-card {

        align-items: flex-start;
    }


    .connected-profile-card::before {

        width: 36px;
        height: 36px;

        flex-basis: 36px;
    }

}
